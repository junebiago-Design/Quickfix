function openDealModal(id, defaultStage) {
    if (isEmployee()) return;
    const d = id ? deals.find(x => x.id === id) : null;
    if (d && !isKanbanSuperuser() && typeof canEdit === 'function' && !canEdit(d.stage)) {
        openDealViewOnly(id);
        return;
    }
    editingId = id || null;
    document.getElementById('deal-modal-title').textContent = d ? 'Edit Task' : 'Add Task';
    document.getElementById('d-title').value = d?.title || '';
    document.getElementById('d-desc').value = d?.desc || '';
    document.getElementById('d-due').value = d?.due || new Date().toISOString().slice(0, 10);
    document.getElementById('d-priority').value = d?.priority || 'medium';
    populateDepartmentSelect(document.getElementById('d-department'), d?.department || '');

    const stageSel = document.getElementById('d-stage');
    stageSel.innerHTML = stages.map(s => `<option value="${s.key}">${s.label}</option>`).join('');
    stageSel.value = d?.stage || defaultStage || stages[0]?.key || '';

    if (d) {
        dealContactRows = (d.contactIds && d.contactIds.length) ? [...d.contactIds] : (d.contactId ? [d.contactId] : []);
    } else {
        const currentUserId = getCurrentEmployeeId();
        const currentDept = getCurrentUserDepartment();
        dealContactRows = [];
        if (currentUserId) dealContactRows.push(currentUserId);
        if (currentDept) {
            const deptEmployees = getEmployeesByDepartment(currentDept);
            deptEmployees.forEach(emp => {
                if (!dealContactRows.includes(emp.id)) dealContactRows.push(emp.id);
            });
        }
    }
    renderDealContactRows();

    if (typeof renderDealModalAttachments === 'function') renderDealModalAttachments();

    openModal('deal-modal');
}

function renderDealContactRows() {
    const el = document.getElementById('d-contact-list');
    if (!el) return;
    const deptSelect = document.getElementById('d-department');
    const selectedDept = deptSelect ? deptSelect.value : '';
    const availableEmployees = selectedDept
        ? getEmployeesNotInDepartment(selectedDept)
        : contacts.filter(c => c.status === 'active');

    if (!dealContactRows.length) {
        el.innerHTML = `<div style="font-size:0.8rem;color:var(--text3);padding:4px 0;">Not assigned to anyone — click "+ Add Assign To" to assign.</div>`;
        return;
    }

    el.innerHTML = dealContactRows.map((val, i) => {
        const contact = contacts.find(c => c.id === val);
        const isInDepartment = contact && contact.department === selectedDept;
        const isCurrentUser = contact && contact.id === getCurrentEmployeeId();
        let optionsHtml = '<option value="">— Select —</option>';
        if (selectedDept) {
            const deptEmployees = getEmployeesByDepartment(selectedDept);
            deptEmployees.forEach(c => {
                const selected = val === c.id ? 'selected' : '';
                const label = isCurrentUser && c.id === getCurrentEmployeeId() ? `${c.fname} ${c.lname} (You)` : `${c.fname} ${c.lname}`;
                optionsHtml += `<option value="${c.id}" ${selected}>${label}</option>`;
            });
        }
        availableEmployees.forEach(c => {
            const selected = val === c.id ? 'selected' : '';
            const label = isCurrentUser && c.id === getCurrentEmployeeId() ? `${c.fname} ${c.lname} (You)` : `${c.fname} ${c.lname}`;
            optionsHtml += `<option value="${c.id}" ${selected}>${label}</option>`;
        });
        if (val && !contacts.find(c => c.id === val)) {
            optionsHtml += `<option value="${val}" selected>${val} (legacy)</option>`;
        }
        return `
      <div style="display:flex;gap:6px;align-items:center;">
        <select onchange="updateDealContactRow(${i}, this.value)" style="flex:1;">
          ${optionsHtml}
        </select>
        <span style="font-size:0.7rem;color:var(--text3);min-width:60px;">${isInDepartment ? 'Department' : 'Manual'}</span>
        <button type="button" class="icon-btn" title="Remove this assignee" onclick="removeDealContactRow(${i})">✕</button>
      </div>
    `;
    }).join('');
}

