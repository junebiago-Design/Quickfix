let dragDealId = null;
let draggingStageKey = null;
let currentDealNotesId = null;
let editingStageKey = null;
let selectedStageColor = '#4f8ef7';
let stageRoleRows = [];
let dealContactRows = [];
const STAGE_COLOR_PALETTE = ['#4f8ef7', '#a78bfa', '#f5c842', '#3ecf8e', '#f56565', '#fb923c', '#38bdf8', '#ec4899'];

function getStageRoles(s) {
    return (s?.roles && s.roles.length) ? s.roles : (s?.role ? [s.role] : []);
}

function getCurrentEmployeeId() {
    if (!currentUser) return null;
    return currentUser.contactId || currentUser.employeeId || null;
}

function getCurrentUserDepartment() {
    if (!currentUser) return null;
    const contactId = currentUser.contactId || currentUser.employeeId;
    if (!contactId) return null;
    const contact = contacts.find(c => c.id === contactId);
    return contact?.department || null;
}

function getEmployeesByDepartment(departmentId) {
    return contacts.filter(c => c.department === departmentId && c.status === 'active');
}

function getEmployeesNotInDepartment(departmentId) {
    return contacts.filter(c => c.department !== departmentId && c.status === 'active');
}

function getUserTaskCounts(employeeId) {
    if (!employeeId || typeof deals === 'undefined') return { completed: 0, pending: 0 };
    const todayStr = new Date().toISOString().slice(0, 10);

    let completed = 0;
    let pending = 0;

    deals.forEach(d => {
        if (d.archived) return;
        const assignedIds = (d.contactIds && d.contactIds.length) ? d.contactIds : (d.contactId ? [d.contactId] : []);
        if (!assignedIds.includes(employeeId)) return;

        const isCompletedForMe = !!(d.completions && d.completions[employeeId]);
        if (isCompletedForMe) {
            completed++;
            return;
        }

        const isOverdue = !!(d.due && d.due < todayStr);
        const hasOpenNotes = (typeof notes !== 'undefined') && notes.some(n => n.dealId === d.id && n.done !== true);
        if (isOverdue || hasOpenNotes) pending++;
    });

    return { completed, pending };
}

function isKanbanSuperuser() {
    return currentUser.role === 'admin' || currentUser.role === SYSTEM_ROLE_ID;
}

function isAdministratorRoleSafe() {
    if (typeof isAdministrator === 'function') return isAdministrator();
    return isKanbanSuperuser();
}

function canActOnStage(stageOrKey) {
    if (isKanbanSuperuser()) return true;
    if (typeof canActOnStageGranular === 'function') return canActOnStageGranular(stageOrKey);
    const stage = typeof stageOrKey === 'string' ? stages.find(s => s.key === stageOrKey) : stageOrKey;
    if (!stage) return true;
    const r = getStageRoles(stage);
    return !r.length || r.includes(currentUser.role);
}

// ── Permission to add new stages ──────────────────────────────────────
// System Administrator always has it; any role with canAddStage: true
// (or inherited) also has it.
function canAddStage() {
    if (isKanbanSuperuser()) return true;
    if (!currentUser || !currentUser.role) return false;
    let roleId = currentUser.role;
    const seen = new Set();
    while (roleId && !seen.has(roleId)) {
        seen.add(roleId);
        const role = roles.find(r => r.id === roleId);
        if (!role) break;
        if (role.canAddStage === true) return true;
        roleId = role.inheritsFrom || null;
    }
    return false;
}

// ── Department → Roles loader ──────────────────────────────────────────

/**
 * Populates stageRoleRows with all distinct role IDs from employees
 * belonging to the given department. Duplicates are avoided.
 */
function loadRolesFromDepartment(departmentId) {
    if (!departmentId) return;
    const deptEmployees = contacts.filter(c => c.department === departmentId && c.status === 'active');
    const roleIds = [...new Set(deptEmployees.map(c => c.role).filter(Boolean))];
    if (!roleIds.length) {
        toast('No active employees found in this department with assigned roles.', 'warning');
        return;
    }
    const currentRoles = new Set(stageRoleRows.filter(Boolean));
    roleIds.forEach(id => currentRoles.add(id));
    stageRoleRows = Array.from(currentRoles);
    renderStageRoleRows();
    toast(`Added ${roleIds.length} role(s) from department.`, 'success');
}

