function moveDealStage(dealId, newStage) {
    const deal = deals.find(d => d.id === dealId);
    if (!deal) return;
    if (deal.stage === newStage) return;
    const superuser = isKanbanSuperuser();
    const grabOk = superuser || typeof canGrab !== 'function' || canGrab(deal.stage);
    const dropOk = superuser || typeof canDrop !== 'function' || canDrop(newStage);
    if (!grabOk || !dropOk) {
        toast('You do not have permission to move this task.', 'error');
        renderStageColumn(deal.stage);
        return;
    }

    const oldStage = deal.stage;
    deal.stage = newStage;
    const oldLabel = stages.find(s => s.key === oldStage)?.label || oldStage;
    const newLabel = stages.find(s => s.key === newStage)?.label || newStage;

    // ✅ logTaskMoved handles BOTH taskActivity AND the main activity feed
    // This prevents double entries in the dashboard Recent Activity
    if (typeof logTaskMoved === 'function') {
        logTaskMoved(deal.id, deal.title, oldStage, newStage);
    }
    
    // ⚠️ REMOVED: Duplicate logActivity() call
    // The logActivity is now handled inside logTaskMoved -> logTaskActivity
    // to prevent double entries in the dashboard activity feed
    
    // ⚠️ REMOVED: toast notification
    // The toast is now handled by the caller or not shown at all
    // to prevent redundant notifications
    
    saveAll();
    renderStageColumn(oldStage);
    renderStageColumn(newStage);
    updateBadges();
    if (currentPage === 'dashboard') renderDashboard();
}

// ── Stage Modal (with Department auto‑load) ──────────────────────────

function openStageModal(key) {
    // ── Permission guard ──
    if (!canAddStage()) {
        toast('You do not have permission to add or edit stages.', 'error');
        return;
    }
    if (isEmployee()) return;

    editingStageKey = key || null;
    const s = key ? stages.find(x => x.key === key) : null;
    document.getElementById('stage-modal-title').textContent = s ? 'Edit Stage' : 'Add Stage';
    document.getElementById('stage-name').value = s?.label || '';
    document.getElementById('stage-final').checked = !!s?.final;

    stageRoleRows = (s?.roles && s.roles.length) ? [...s.roles] : (s?.role ? [s.role] : []);
    renderStageRoleRows();

    // ── Populate and attach department auto‑load ──
    const deptSelect = document.getElementById('stage-department-select');
    if (deptSelect) {
        deptSelect.innerHTML = '<option value="">— Load roles from department —</option>';
        departments.forEach(d => {
            if (d.id) {
                const opt = document.createElement('option');
                opt.value = d.id;
                opt.textContent = d.name || 'Unnamed Department';
                deptSelect.appendChild(opt);
            }
        });
        deptSelect.onchange = function() {
            if (this.value) loadRolesFromDepartment(this.value);
            this.value = '';
        };
    }

    selectedStageColor = s?.color || STAGE_COLOR_PALETTE[stages.length % STAGE_COLOR_PALETTE.length];
    renderStageColorPicker();

    const delBtn = document.getElementById('stage-delete-btn');
    delBtn.style.display = s ? '' : 'none';

    const permBtn = document.getElementById('stage-permissions-btn');
    if (permBtn) permBtn.style.display = s ? '' : 'none';

    openModal('stage-modal');
}

